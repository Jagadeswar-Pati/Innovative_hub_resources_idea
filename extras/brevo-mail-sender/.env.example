# Brevo API key (from Brevo dashboard: SMTP & API > API Keys)
BREVO_API_KEY=your_brevo_api_key_here

# Email that receives the message when you click Send
TO_EMAIL=inovativehubofficial@gmail.com

# Sender (who the email is "from") – keep in .env
# If not set, SENDER_EMAIL defaults to TO_EMAIL and SENDER_NAME to "Brevo Mail Sender"
SENDER_EMAIL=inovativehubofficial@gmail.com
SENDER_NAME=Innovative Hub

# Optional: port (default 3000)
# PORT=3000
