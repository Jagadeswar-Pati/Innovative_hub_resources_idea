# Resources Hub Backend - Environment Variables
# Copy to .env and fill in values

# MongoDB - copy your SAME MONGODB_URI from backend/.env
# Data goes to separate database "resources_hub" (same cluster, different DB in Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/innovative_hub?retryWrites=true&w=majority

# JWT for module auth (temp users)
RESOURCES_JWT_SECRET=your-secret-key-change-in-production

# Cloudinary (image uploads only - video disabled)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin key for Resources Hub admin routes
RESOURCES_ADMIN_SECRET=your-admin-secret

# Server
RESOURCES_PORT=5001

# CORS (frontend origin - resourcesi runs on 5174 by default)
RESOURCES_CORS_ORIGIN=http://localhost:5174

# Frontend base URL (for verification links)
FRONTEND_URL=http://localhost:5174

# Set to 'true' to skip email verification (dev only - accounts active immediately)
SKIP_EMAIL_VERIFICATION=true
