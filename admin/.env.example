# Admin Panel - Resources Hub Integration
# Add these for Resources Hub admin features

# Resources Hub backend admin API (default: http://localhost:5001/api/resources/admin)
VITE_RESOURCES_ADMIN_API_URL=http://localhost:5001/api/resources/admin

# Admin key - must match RESOURCES_ADMIN_SECRET in resourcesi/backend
VITE_RESOURCES_ADMIN_KEY=your-admin-secret
